{
  "name": "speranza-quest-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial fan-made quest tracker for Arc Raiders. Not affiliated with Embark Studios.",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "sync": "npm run vendor && npx cap sync ios",
    "ios": "npm run sync && npx cap open ios",
    "icons": "npx @capacitor/assets generate --ios"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dagre": "0.8.5"
  }
}
